{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "EM4 Script",
  "scopeName": "source.em4script",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#preprocessor" },
    { "include": "#enums" },
    { "include": "#declarations" },
    { "include": "#functionDefinitions" },
    { "include": "#functionCalls" },
    { "include": "#variables" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#literals" },
    { "include": "#numbers" },
    { "include": "#operators" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.em4script",
          "begin": "//",
          "beginCaptures": { "0": { "name": "punctuation.definition.comment.em4script" } },
          "end": "(?=$)"
        },
        {
          "name": "comment.block.em4script",
          "begin": "/\\*",
          "beginCaptures": { "0": { "name": "punctuation.definition.comment.begin.em4script" } },
          "end": "\\*/",
          "endCaptures": { "0": { "name": "punctuation.definition.comment.end.em4script" } }
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.em4script",
          "begin": "\"",
          "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.em4script" } },
          "end": "\"|(?=$)",
          "endCaptures": { "0": { "name": "punctuation.definition.string.end.em4script" } },
          "applyEndPatternLast": 1,
          "patterns": [
            { "name": "constant.character.escape.em4script", "match": "\\\\(?:[\\\\\"'nrt0]|x[0-9A-Fa-f]{2}|[0-7]{1,3})" },
            { "name": "invalid.illegal.escape.em4script", "match": "\\\\." }
          ]
        },
        {
          "name": "string.quoted.single.em4script",
          "begin": "'",
          "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.em4script" } },
          "end": "'|(?=$)",
          "endCaptures": { "0": { "name": "punctuation.definition.string.end.em4script" } },
          "applyEndPatternLast": 1,
          "patterns": [
            { "name": "constant.character.escape.em4script", "match": "\\\\(?:[\\\\\"'nrt0]|x[0-9A-Fa-f]{2}|[0-7]{1,3})" },
            { "name": "invalid.illegal.escape.em4script", "match": "\\\\." }
          ]
        }
      ]
    },
    "preprocessor": {
      "patterns": [
        {
          "name": "meta.preprocessor.include.em4script",
          "match": "^(\\s*#\\s*)(include)\\s*([<\"])([^>\"]+)([>\"])",
          "captures": {
            "1": { "name": "punctuation.definition.preprocessor.em4script" },
            "2": { "name": "keyword.control.preprocessor.include.em4script" },
            "3": { "name": "punctuation.definition.string.begin.em4script" },
            "4": { "name": "string.quoted.other.include.em4script" },
            "5": { "name": "punctuation.definition.string.end.em4script" }
          }
        },
        {
          "name": "meta.preprocessor.define.em4script",
          "match": "^(\\s*#\\s*)(define)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "punctuation.definition.preprocessor.em4script" },
            "2": { "name": "keyword.control.preprocessor.define.em4script" },
            "3": { "name": "entity.name.constant.preprocessor.em4script" }
          }
        },
        {
          "name": "meta.preprocessor.directive.em4script",
          "match": "^(\\s*#\\s*)(if|ifdef|ifndef|elif|else|endif|undef|pragma|error|warning)\\b",
          "captures": {
            "1": { "name": "punctuation.definition.preprocessor.em4script" },
            "2": { "name": "keyword.control.preprocessor.em4script" }
          }
        }
      ]
    },
    "enums": {
      "patterns": [
        {
          "name": "meta.enum.declaration.em4script",
          "begin": "^\\s*(enum)\\b(?:\\s+([A-Za-z_][A-Za-z0-9_]*))?\\s*$",
          "beginCaptures": {
            "1": { "name": "storage.type.enum.em4script" },
            "2": { "name": "entity.name.type.enum.em4script" }
          },
          "while": "^\\s*(?:\\{|[A-Za-z_][A-Za-z0-9_]*\\s*(?:=\\s*[^,}]*)?\\s*,|[A-Z_][A-Z0-9_]*\\s*(?:=\\s*[^,}]*)?|//.*|/\\*.*|\\*.*|\\*/\\s*)?$",
          "patterns": [
            { "include": "#comments" },
            { "include": "#numbers" },
            { "include": "#operators" },
            { "name": "constant.other.enum.em4script", "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\b(?=\\s*(?:=|,|$))" },
            { "include": "#punctuation" }
          ]
        },
        {
          "name": "meta.enum.member.access.em4script",
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)(::)([A-Za-z_][A-Za-z0-9_]*)(?!\\s*\\()\\b",
          "captures": {
            "1": { "name": "entity.name.type.enum.em4script" },
            "2": { "name": "punctuation.accessor.em4script" },
            "3": { "name": "constant.other.enum.em4script" }
          }
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "name": "meta.declaration.inheritance.em4script",
          "match": "\\b(class|struct|union|object)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*(:)\\s*(?:(public|private|protected)\\s+)?([A-Za-z_][A-Za-z0-9_:]*)",
          "captures": {
            "1": { "name": "storage.type.declaration.em4script" },
            "2": { "name": "entity.name.type.em4script" },
            "3": { "name": "punctuation.separator.inheritance.em4script" },
            "4": { "name": "storage.modifier.access.em4script" },
            "5": { "name": "entity.other.inherited-class.em4script" }
          }
        },
        {
          "name": "meta.declaration.type.em4script",
          "match": "\\b(namespace|class|struct|union|enum|object)\\s+([A-Za-z_][A-Za-z0-9_]*)\\b",
          "captures": {
            "1": { "name": "storage.type.declaration.em4script" },
            "2": { "name": "entity.name.type.em4script" }
          }
        },
        {
          "name": "storage.type.enum.em4script",
          "match": "\\benum\\b(?=\\s*(?:\\{|$))"
        }
      ]
    },
    "functionDefinitions": {
      "patterns": [
        {
          "name": "meta.function.definition.em4script",
          "match": "^\\s*(?:(virtual|static|inline|extern)\\s+)*(?:(const)\\s+)?([A-Za-z_][A-Za-z0-9_:<>]*)(?:\\s*([*&]))?\\s+([~]?[A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": { "name": "storage.modifier.em4script" },
            "2": { "name": "storage.modifier.em4script" },
            "3": { "name": "entity.name.type.return.em4script" },
            "4": { "name": "keyword.operator.pointer.em4script" },
            "5": { "name": "entity.name.function.em4script" }
          }
        },
        {
          "name": "meta.function.destructor.em4script",
          "match": "^\\s*(~[A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()",
          "captures": { "1": { "name": "entity.name.function.destructor.em4script" } }
        }
      ]
    },
    "functionCalls": {
      "patterns": [
        {
          "name": "meta.function.call.qualified.em4script",
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)(\\s*::\\s*)([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": { "name": "entity.name.type.namespace.em4script" },
            "2": { "name": "punctuation.accessor.em4script" },
            "3": { "name": "entity.name.function.em4script" }
          }
        },
        {
          "name": "meta.function.call.member.em4script",
          "match": "(->|\\.)\\s*([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": { "name": "punctuation.accessor.em4script" },
            "2": { "name": "entity.name.function.em4script" }
          }
        },
        {
          "name": "meta.function.call.em4script",
          "match": "\\b(?!if\\b|for\\b|while\\b|switch\\b|catch\\b|return\\b|sizeof\\b)([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()",
          "captures": { "1": { "name": "entity.name.function.em4script" } }
        }
      ]
    },
    "variables": {
      "patterns": [
        {
          "name": "meta.variable.declaration.builtin.em4script",
          "begin": "\\b((?:const\\s+)?(?:void|bool|int|float|double|char|string|signed|unsigned)(?:\\s+(?:long|short|int|char))*)\\s*([*&]?)\\s*([A-Za-z_][A-Za-z0-9_]*)",
          "beginCaptures": {
            "1": { "name": "storage.type.em4script" },
            "2": { "name": "keyword.operator.pointer.em4script" },
            "3": { "name": "variable.other.declaration.em4script" }
          },
          "end": "(?==|\\(|;|$)",
          "applyEndPatternLast": 1,
          "patterns": [
            { "include": "#declarationContents" }
          ]
        },
        {
          "name": "meta.variable.declaration.custom.em4script",
          "begin": "\\b(const\\s+)?([A-Z][A-Za-z0-9_:<>]*)\\s*([*&]?)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "beginCaptures": {
            "1": { "name": "storage.modifier.em4script" },
            "2": { "name": "entity.name.type.class.em4script" },
            "3": { "name": "keyword.operator.pointer.em4script" },
            "4": { "name": "variable.other.declaration.em4script" }
          },
          "end": "(?==|\\(|;|$)",
          "applyEndPatternLast": 1,
          "patterns": [
            { "include": "#declarationContents" }
          ]
        },
        {
          "name": "meta.variable.assignment.em4script",
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\b(?=\\s*(?:\\[[^\\]]*\\]\\s*)?(?:=|\\+=|-=|\\*=|/=|%=|<<=|>>=|&=|\\|=|\\^=))",
          "captures": { "1": { "name": "variable.other.assignment.em4script" } }
        },
        { "name": "variable.language.em4script", "match": "\\b(this|super|nullptr)\\b" },
        {
          "name": "meta.member.access.em4script",
          "match": "(->|\\.|::)\\s*([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "punctuation.accessor.em4script" },
            "2": { "name": "variable.other.member.em4script" }
          }
        }
      ]
    },
    "declarationContents": {
      "patterns": [
        {
          "name": "meta.variable.declaration.additional.em4script",
          "match": ",\\s*([*&]?)\\s*([A-Za-z_][A-Za-z0-9_]*)(?=\\s*(?:\\[[^\\]]*\\]\\s*)?(?:,|;|=|\\())",
          "captures": {
            "1": { "name": "keyword.operator.pointer.em4script" },
            "2": { "name": "variable.other.declaration.em4script" }
          }
        },
        { "include": "#comments" },
        { "include": "#punctuation" }
      ]
    },
    "keywords": {
      "patterns": [
        { "name": "keyword.control.em4script", "match": "\\b(if|else|for|while|do|switch|case|default|break|continue|return|try|catch|throw)\\b" },
        { "name": "keyword.operator.word.em4script", "match": "\\b(new|delete|sizeof)\\b" },
        { "name": "storage.modifier.em4script", "match": "\\b(virtual|static|const|volatile|inline|extern|override|final|public|private|protected|typedef)\\b" },
        { "name": "storage.type.declaration.em4script", "match": "\\b(namespace|class|struct|union|enum|object)\\b" }
      ]
    },
    "types": {
      "patterns": [
        { "name": "storage.type.primitive.em4script", "match": "\\b(void|bool|int|float|double|char|string|short|long|signed|unsigned)\\b" },
        {
          "name": "entity.name.type.class.em4script",
          "match": "\\b([A-Z][A-Za-z0-9_:<>]*)\\b(?=\\s*(?:[*&]\\s*)?[A-Za-z_][A-Za-z0-9_]*\\s*(?:[=;,)\\[(]))",
          "captures": { "1": { "name": "entity.name.type.class.em4script" } }
        }
      ]
    },
    "literals": {
      "patterns": [
        { "name": "constant.language.boolean.em4script", "match": "\\b(true|false)\\b" },
        { "name": "constant.language.null.em4script", "match": "\\b(null|NULL|nullptr)\\b" },
        { "name": "constant.other.em4script", "match": "\\b[A-Z][A-Z0-9_]{2,}\\b" }
      ]
    },
    "numbers": {
      "patterns": [
        { "name": "constant.numeric.hex.em4script", "match": "\\b0[xX][0-9A-Fa-f]+(?:[uUlL]{0,2})\\b" },
        { "name": "constant.numeric.binary.em4script", "match": "\\b0[bB][01]+(?:[uUlL]{0,2})\\b" },
        { "name": "constant.numeric.float.em4script", "match": "(?<![A-Za-z0-9_])(?:\\d+\\.\\d*|\\.\\d+|\\d+[eE][+-]?\\d+)(?:[eE][+-]?\\d+)?[fF]?\\b" },
        { "name": "constant.numeric.integer.em4script", "match": "\\b\\d+(?:[uUlL]{0,2})\\b" }
      ]
    },
    "operators": {
      "patterns": [
        { "name": "keyword.operator.access.em4script", "match": "->|::" },
        { "name": "keyword.operator.assignment.em4script", "match": "<<=|>>=|\\+=|-=|\\*=|/=|%=|&=|\\|=|\\^=|=" },
        { "name": "keyword.operator.comparison.em4script", "match": "==|!=|<=|>=|<|>" },
        { "name": "keyword.operator.logical.em4script", "match": "&&|\\|\\||!" },
        { "name": "keyword.operator.arithmetic.em4script", "match": "\\+\\+|--|\\+|-|\\*|/|%" },
        { "name": "keyword.operator.bitwise.em4script", "match": "<<|>>|&|\\||\\^|~" },
        { "name": "keyword.operator.ternary.em4script", "match": "\\?|:" }
      ]
    },
    "punctuation": {
      "patterns": [
        { "name": "punctuation.separator.comma.em4script", "match": "," },
        { "name": "punctuation.terminator.statement.em4script", "match": ";" },
        { "name": "punctuation.section.block.begin.em4script", "match": "\\{" },
        { "name": "punctuation.section.block.end.em4script", "match": "\\}" },
        { "name": "punctuation.section.group.begin.em4script", "match": "\\(" },
        { "name": "punctuation.section.group.end.em4script", "match": "\\)" },
        { "name": "punctuation.section.brackets.begin.em4script", "match": "\\[" },
        { "name": "punctuation.section.brackets.end.em4script", "match": "\\]" }
      ]
    }
  }
}
